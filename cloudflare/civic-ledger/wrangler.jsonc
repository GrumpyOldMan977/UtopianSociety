{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "utopian-civic-ledger",
  "main": "src/index.js",
  "compatibility_date": "2026-07-19",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "utopian-civic-ledger",
      "database_id": "6a26d8ba-8cda-4cb1-9980-4dd3ba6ff1a3",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
