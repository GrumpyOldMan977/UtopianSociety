# Server-side WordPress.com OAuth token used only for private view statistics.
WPCOM_ACCESS_TOKEN=

# The following values belong in cloudflare/civic-ledger/.dev.vars when
# developing protected Worker write paths locally. Never commit real values.
LEDGER_ADMIN_KEY=
TURNSTILE_SECRET=

# Optional override used by scripts/register-ledger-release.mjs.
CIVIC_LEDGER_API=https://utopian-civic-ledger.utopian-society-civic.workers.dev
